# GigSave - consolidated environment template.
#
# Architecture: one Python/FastAPI financial API + one Python/FastAPI ML service,
# both on Supabase PostgreSQL. There is no MongoDB and no Node service.
#
# Copy to .env at the repo root (docker-compose reads it) and fill in real values.

# ---------------------------------------------------------------------------
# Supabase PostgreSQL
# ---------------------------------------------------------------------------
# The ONLY connection setting the backend reads. backend/database.py refuses to
# start without it - there is no local/SQLite fallback by design.
# Use the Supabase connection pooler URI for the port shown in your dashboard.
DATABASE_URL=postgresql://<db_user>:<db_password>@<host>:5432/<db_name>

# ---------------------------------------------------------------------------
# Webhook ingestion (POST /webhooks/transaction, POST /webhooks/sweep)
# ---------------------------------------------------------------------------
# Shared secret for inbound bank / gig-platform webhooks. Callers send either
# X-Webhook-Signature (hex HMAC-SHA256 of the raw body) or X-Webhook-Secret.
# Leave unset to keep the webhook endpoints closed - they fail shut, not open.
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# ML scoring service
# ---------------------------------------------------------------------------
PORT=8001

# ---------------------------------------------------------------------------
# Frontend (Vite). Resolved in the browser, so these must be host-reachable
# URLs, not Docker service names. See frontend/dashboard/.env.example.
# ---------------------------------------------------------------------------
VITE_FINANCIAL_API_URL=http://localhost:8000
VITE_ML_API_URL=http://localhost:8001
VITE_DASHBOARD_USER_ID=<user_id_with_rows_in_supabase>
