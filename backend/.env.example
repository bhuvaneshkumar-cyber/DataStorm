# Copy to backend/.env (or project-root .env — database.py checks both).

# Supabase PostgreSQL connection string. Replace with your project's values.
# SQLite also works for local development: sqlite:///./local.db
DATABASE_URL=postgresql://<db_user>:<db_password>@<host>:5432/<db_name>

# Signing key for access tokens. REQUIRED in any deployment: without it the
# service generates a random key per process, which invalidates every session on
# restart. Use a long random value, e.g. `python -c "import secrets;
# print(secrets.token_urlsafe(48))"`.
JWT_SECRET=

# How long an access token stays valid.
JWT_TTL_HOURS=12

# Where the scoring service lives. The backend scores server-side rather than
# trusting the browser, so this is a hard dependency for the credit, insurance
# and loan routes.
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT=10

# Minimum alternative credit score needed to apply for an emergency loan, and
# the smallest advance worth issuing. Keep the threshold aligned with
# ml_service's SCORE_STANDARD or "eligible to apply" and "not auto-declined"
# stop lining up.
LOAN_APPLY_THRESHOLD=400
LOAN_MIN_AMOUNT=1000

# Comma-separated allowlist of browser origins. Defaults to "*" for local
# development; set a real list before this faces the internet.
CORS_ORIGINS=*
