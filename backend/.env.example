# Copy to backend/.env (or the project-root .env - database.py checks both).

# Supabase PostgreSQL connection string. Required: the service will not start
# without it, and it never falls back to a local database.
DATABASE_URL=postgresql://<db_user>:<db_password>@<host>:5432/<db_name>

# Shared secret for inbound transaction webhooks. Unset means the webhook
# endpoints reject every caller.
WEBHOOK_SECRET=
