# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# -- Server ------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# -- MongoDB -----------------------------------------------------------------
# Local:  mongodb://localhost:27017/gigsave
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gigsave
MONGO_URI=mongodb://localhost:27017/gigsave

# -- Savings Engine defaults (mirrors savings.py constants) ------------------
SAVINGS_THRESHOLD=100
SAVINGS_MANDATE_LIMIT=1000
SAVINGS_ROUND_UP_MULTIPLE=50
SAVINGS_SURPLUS_PERCENTAGE=0.10
SAVINGS_ROLLING_WINDOW=30

# -- Webhook -----------------------------------------------------------------
WEBHOOK_SECRET=changeme
