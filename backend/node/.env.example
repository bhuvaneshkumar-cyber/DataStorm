# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# -- Server ------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# -- Supabase ----------------------------------------------------------------
# Use the project URL and a server-only service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -- Savings Engine defaults (mirrors savings.py constants) ------------------
SAVINGS_THRESHOLD=100
SAVINGS_MANDATE_LIMIT=1000
SAVINGS_ROUND_UP_MULTIPLE=50
SAVINGS_SURPLUS_PERCENTAGE=0.10
SAVINGS_ROLLING_WINDOW=30

# -- Webhook -----------------------------------------------------------------
WEBHOOK_SECRET=changeme
