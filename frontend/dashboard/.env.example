# Copy to frontend/dashboard/.env.local. Vite only exposes vars prefixed VITE_
# to browser code (import.meta.env.VITE_*) — these are read client-side and are
# not secret.

# The financial engine: authentication, expenses, platforms, loans, tax, bot.
VITE_BACKEND_URL=http://localhost:8000

# The scoring service. The browser calls it directly for statement upload and
# financial-statement analysis, so the file never passes through the backend.
VITE_ML_URL=http://localhost:8001
