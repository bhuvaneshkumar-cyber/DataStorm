# Copy to frontend/dashboard/.env.local. Vite only exposes vars prefixed VITE_ to
# browser code (import.meta.env.VITE_*) - these are read client-side, not secret.
#
# All three are REQUIRED. The dashboard has no local fallback data: if a var is
# missing or a service is unreachable, the UI shows the failure instead of
# rendering placeholder numbers.

# Python financial API (backend/main.py) - savings, sweeps, dashboard.
VITE_FINANCIAL_API_URL=http://localhost:8000

# Python ML scoring service (ml_service/main.py) - credit score + SHAP factors.
VITE_ML_API_URL=http://localhost:8001

# No auth flow exists yet, so the dashboard renders one fixed user's savings.
# Must be a user_id that actually has rows in Supabase.
VITE_DASHBOARD_USER_ID=c666bc75-751c-4e4b-866b-af5b0393d131
