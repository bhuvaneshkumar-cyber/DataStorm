# Copy to frontend/dashboard/.env.local. Vite only exposes vars prefixed VITE_ to
# browser code (import.meta.env.VITE_*) — these are read client-side, not secret.
VITE_BACKEND_URL=http://localhost:8000
VITE_ML_URL=http://localhost:8001

# No auth/registration flow exists yet (see checkpoint.md); the dashboard reads
# one fixed demo user's data. Set this to a user_id that actually has rows in
# Supabase, or leave it — the dashboard falls back to local demo data on a 404.
VITE_DEMO_USER_ID=c666bc75-751c-4e4b-866b-af5b0393d131
