# Copy to frontend/dashboard/.env.local. Vite only exposes vars prefixed VITE_ to
# browser code (import.meta.env.VITE_*) - these are read client-side, not secret.
#
# Both fall back to localhost defaults in lib/client.ts, so they only need to be
# set once a service is not running on the default port (e.g. in a deployment).

# Python financial API (backend/main.py) - auth, money, loans, tax, bot.
VITE_BACKEND_URL=http://localhost:8000

# Python ML scoring service (ml_service/main.py) - credit score, SHAP factors,
# statement/financials upload.
VITE_ML_URL=http://localhost:8001
