# Copy to ml_service/.env if you set these outside docker-compose.
# Every value has a working default in config.py; nothing here is required.

# Port this service listens on. backend/main.py already owns 8000, keep distinct.
PORT=8001

# --- Hybrid score composition (must sum to 1.0) ---
RULE_WEIGHT=0.4
ML_WEIGHT=0.6

# --- Score bands on the 0-800 scale ---
# GOOD and STANDARD are the public category boundaries AND the approve/refer/
# decline boundaries. EXCELLENT only splits the approve band into two price tiers.
SCORE_EXCELLENT=680
SCORE_GOOD=600
SCORE_STANDARD=400

# --- Risk-based pricing ---
BASE_INTEREST_RATE_PCT=14.0
RISK_PREMIUM_LOW_BPS=150
RISK_PREMIUM_MODERATE_BPS=350
RISK_PREMIUM_HIGH_BPS=700
RISK_PREMIUM_VERY_HIGH_BPS=1200

# Credit limit as a multiple of monthly payout.
LOAN_MULTIPLIER_LOW=3.0
LOAN_MULTIPLIER_MODERATE=2.0
LOAN_MULTIPLIER_HIGH=1.0

# --- Statement upload (POST /analyze-statement) ---
MAX_UPLOAD_BYTES=26214400
MIN_STATEMENT_DAYS=14
